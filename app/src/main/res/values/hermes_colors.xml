<resources>
    <!--
        The XML mirror of the Compose schemes in ui/theme/Color.kt. These exist
        for the things Compose cannot theme: the adaptive icon, the splash
        window, and the pre-Compose window background. Keep them in step with
        the Kotlin scheme — a colour here that disagrees with the one in the
        app shows up as a colour shift on every cold start.

        Warm ink, sand and clay: the same palette, spelled for XML.
    -->
    <color name="hermes_deep">#FF100D0B</color>
    <color name="hermes_surface">#FF1A1512</color>
