    <color name="hermes_primary_dark">#FFF0BE9A</color>
    <color name="hermes_primary_container">#FF5C2F17</color>
    <color name="hermes_secondary">#FFCDBBA6</color>
    <color name="hermes_accent">#FFD9B173</color>
    <color name="hermes_error">#FFFF9C86</color>
