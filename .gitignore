# Build outputs
build/
.gradle/
.kotlin/
*.apk
*.aab
*.log

# Python bytecode (pc/ scripts import netinfo.py, which creates this)
__pycache__/
*.pyc

# Local config
local.properties

# IDE
.idea/
*.iml
.cxx/

# OS
Thumbs.db

# Phase 0 probe secrets
pc/.probe-token
pc/.dashboard-password

# Local device/runtime state - contains MAC addresses, DHCP IPs and host
# identifiers for the paired phone. Machine-specific and privacy-sensitive:
# never publish. Regenerated automatically at runtime.
pc/known-devices.json
pc/.watchdog-state
pc/*.log

# Build/install transcripts and vendored installers - noise, not source
build_log.txt
build-debug.log
winget_install.log
tailscale.apk

# Pairing QR images encode the dashboard password in plaintext. Generated on
# demand by pc/make_pair_qr.py; must never enter git history.
pc/pair-qr.png
pc/*-qr.png

# foundry chat-sync runtime leftovers
pc/foundry-sync.log
